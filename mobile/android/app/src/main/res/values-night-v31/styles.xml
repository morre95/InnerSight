<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 and later show their own splash screen first: an icon on a plain
         background. It gets the logo and color of launch_background.xml. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
    </style>
</resources>
