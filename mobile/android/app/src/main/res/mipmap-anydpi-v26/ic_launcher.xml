<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher icon on Android 8 and later: the eye of the splash screen on its color.
     The launcher cuts it to its own shape, so the eye stays inside the middle 66 of 108 dp. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/splash_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
