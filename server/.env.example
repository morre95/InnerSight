# Copy this file to .env and fill it in. The .env file holds secrets and stays out of git.

# The domain name that points at this server. Caddy gets its certificate for it.
INBOX_DOMAIN=inbox.example.com

# Two different secrets of at least 32 characters. Make each with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# The upload token goes into the app, under Advanced. It can add examples and nothing else.
INBOX_UPLOAD_TOKEN=replace-with-a-secret-made-as-above
# The pull token stays on the computer that trains. It can read and remove the examples.
INBOX_PULL_TOKEN=replace-with-another-secret-made-as-above

# The web pages that may upload from a browser, separated by commas. The Android app needs none.
INBOX_ALLOWED_ORIGINS=https://morre95.github.io
